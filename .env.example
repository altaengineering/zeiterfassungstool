DATABASE_URL="postgresql://user:password@localhost:5432/zeiterfassung"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Optional: E-Mail-Benachrichtigung an Admins bei Krankmeldung (siehe CLAUDE.md). Ohne
# RESEND_API_KEY wird nur eine Konsolen-Warnung ausgegeben, kein Fehler.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

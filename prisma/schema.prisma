// Datenmodell gemäss CLAUDE.md §2.
// POC-Stand (siehe CLAUDE.md "Status"): SQLite für lokale Demo, kostenlos & ohne Setup.
// Produktion später: PostgreSQL (Infomaniak, Schweiz) — dazu provider unten umstellen und
// Migrationen neu erzeugen. SQLite kennt weder natives `enum` noch `@db.Date`, daher hier
// bewusst auf provider-neutrale Typen (String statt enum, DateTime statt @db.Date) gehalten.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Gültige Werte: "MITARBEITER" | "ADMIN" (kein natives enum wegen SQLite, siehe Hinweis oben).

model Company {
  id           String    @id @default(cuid())
  name         String
  users        User[]
  holidays     Holiday[]
  settings     CompanySettings[]
  monthCloses  MonthClose[]
}

// Persönliche Projektliste (bewusst PRO PERSON, nicht firmenweit, siehe CLAUDE.md): löst zwei
// Probleme auf einmal, freies Getippe führt zu Tippfehler-Varianten desselben Projekts, und der
// Excel-Export bekam dadurch pro Monat inkonsistente Spalten. Jede Person pflegt ihre eigene Liste
// unter /projekte, im Tageseintrag wird nur noch aus der eigenen Liste ausgewählt statt frei
// getippt. `userId` ist bewusst optional: bestehende Projekte aus der Zeit vor dieser Umstellung
// (companyId-basiert) landen mit `userId = null`, bis die betroffene Person sie unter /projekte per
// Migrations-Knopf für sich beansprucht (siehe src/lib/projects.ts).
model Project {
  id        String    @id @default(cuid())
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  name      String
  aktiv     Boolean   @default(true)
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@unique([userId, name])
}

// Monatsabschluss: sobald ein Monat abgeschlossen ist, können Mitarbeitende ihre Tageseinträge
// für diesen Monat nicht mehr ändern (App-eigenes Feature, nicht aus dem Original-Excel).
// Gilt firmenweit für alle Mitarbeitenden gleichzeitig (typischer Lohnlauf-Abschluss).
model MonthClose {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  year      Int
  month     Int // 1-12
  closedAt  DateTime @default(now())

  @@unique([companyId, year, month])
}

// Firmenweite, jahresabhängige Konstanten (CLAUDE.md §2, §7 Punkt 3: Jahresferientage bleibt
// globale Konstante, nicht pro Mitarbeitendem — aber pro Firma/Jahr administrierbar).
model CompanySettings {
  id                String  @id @default(cuid())
  company           Company @relation(fields: [companyId], references: [id])
  companyId         String
  year              Int
  kmSpesensatz      Float // CHF/km, Summen!B44
  jahresferientage  Float // Tage/Jahr, Summen!B16 (Default: 6.5/12*20-0.00333333 ≈ 10.83)

  @@unique([companyId, year])
}

model Holiday {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  date      DateTime
  label     String
  bezahlt   Boolean // true = "ja", false = "nein" — siehe CLAUDE.md §3 (Soll-Formel)

  @@unique([companyId, date])
}

model User {
  id             String    @id @default(cuid())
  company        Company   @relation(fields: [companyId], references: [id])
  companyId      String
  name           String
  email          String    @unique
  passwordHash   String
  role           String    @default("MITARBEITER")
  // Datum des Firmeneintritts, fuer die Dienstalter-Sortierung in Nutzerverwaltung und
  // Chef-Uebersicht (siehe src/lib/dienstalter.ts). Optional, weil nicht fuer jede Person bekannt,
  // Personen ohne Wert werden in der Sortierung ans Ende gestellt statt geraten.
  eintrittsdatum DateTime?

  jahresStammdaten JahresStammdaten[]
  dailyEntries     DailyEntry[]
  pensumWechsel    PensumWechsel[]
  projekte         Project[]
  notizen          KalenderNotiz[]
  ferienAntraege   FerienAntrag[]
}

// Freie Notiz zu einem Tag im geteilten Kalender (/kalender). Privat = nur für die eigene Person
// sichtbar (z.B. "Zahnarzttermin"), öffentlich = für alle in der Firma sichtbar (z.B. "Homeoffice",
// "im Kundentermin"). Bewusst kein eigener Bezug zu DailyEntry, eine Notiz ist unabhängig davon, ob
// an dem Tag überhaupt Stunden erfasst wurden.
model KalenderNotiz {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  date        DateTime
  text        String
  oeffentlich Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Abwesenheitsantrag (Modellname aus historischen Gruenden noch FerienAntrag, siehe `typ`): eine
// Person beantragt einen Zeitraum, ein Admin genehmigt oder lehnt ab. Bei Genehmigung eines
// "ferien"-Antrags werden fuer alle Arbeitstage im Zeitraum automatisch DailyEntry-Zeilen mit
// ferien=Soll-pro-Tag (ganztags) angelegt/aktualisiert (siehe src/lib/ferienAntrag.ts) — sonst
// wuerde der Antrag zwar als "genehmigt" dastehen, aber am Ferien-Saldo (der nur echte
// Tageseintraege zaehlt) nichts aendern. Bei "gleitzeit" braucht es das nicht: ein nicht
// gearbeiteter Arbeitstag senkt den Gleitzeit-Stand bereits von selbst ueber die normale Soll/Ist-
// Differenz, die Genehmigung legt dort nur eine leere DailyEntry-Zeile (damit der Tag nicht als
// "nicht erfasst" auffaellt) sowie eine oeffentliche KalenderNotiz an (damit sichtbar ist, warum).
model FerienAntrag {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id])
  userId         String
  von            DateTime
  bis            DateTime
  // Anzahl Arbeitstage im Zeitraum, beim Erstellen berechnet und fest gespeichert (nicht bei jeder
  // Anzeige neu berechnet), damit eine spaetere Aenderung an Feiertagen die Historie nicht
  // rueckwirkend verfaelscht.
  arbeitstage    Float
  // "ferien" | "gleitzeit", additiv ergaenzt (2026-09-23), Default haelt bestehende Zeilen gueltig.
  typ            String    @default("ferien")
  kommentar      String?
  // "offen" | "genehmigt" | "abgelehnt"
  status         String    @default("offen")
  erstelltAm     DateTime  @default(now())
  entschiedenAm  DateTime?
  entschiedenVon String?

  @@index([userId])
}

// App-eigenes Feature (nicht aus dem Original-Excel, das pro Jahr nur einen konstanten
// Anstellungsgrad kennt — siehe Summen!B5/B6): erlaubt einen Pensumwechsel MITTEN im Jahr. Ab
// `gueltigAb` gilt der neue Wert für den Tages-Soll, alle Tage davor rechnen mit dem "davor"
// gültigen Wert (letzter Wechsel mit gueltigAb <= Datum, sonst die Basis aus JahresStammdaten des
// jeweiligen Jahres) — siehe `src/lib/calc/pensum.ts`.
model PensumWechsel {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  gueltigAb     DateTime
  anstellungPct Float
  wochenstunden Float
  createdAt     DateTime @default(now())

  @@unique([userId, gueltigAb])
}

// Entspricht Blatt "Summen", Zellen B1-B44 (CLAUDE.md §2). Ein Datensatz pro User + Jahr.
model JahresStammdaten {
  id        String @id @default(cuid())
  user      User   @relation(fields: [userId], references: [id])
  userId    String
  year      Int

  anstellungPct                Float // Summen!B5, z.B. 1.0 = 100%
  wochenstunden                Float // Summen!B6, z.B. 42
  anzahlVorholtage              Float @default(0) // Summen!B10
  stundenuebertragAltesJahr    Float @default(0) // Summen!B14 -> Startwert Stand am 1. Januar
  ferienuebertragAltesJahr     Float @default(0) // Summen!B15
  arbeitsmonate                 Float @default(12) // Summen!B17

  // Nicht aus dem Original-Excel, App-eigenes Feature: Summen!B16 war im Original firmenweit eine
  // einzige, fest verdrahtete Formel (6.5/12*20-0.00333333 ≈ 10.83 Tage/Jahr), gilt aber in
  // Wirklichkeit nicht fuer alle gleich (z.B. Lernende/unter 20 Jahren haben laut Art. 329a OR
  // Anspruch auf 25 statt 20 Tage). NULL = kein persoenlicher Wert hinterlegt, dann zaehlt weiter
  // CompanySettings.jahresferientage bzw. der Standard-Wert (siehe berechneJahresferientage).
  jahresferientage Float?

  // Nicht aus dem Original-Excel, App-eigenes Feature: "Ferien bezogen" wird normalerweise nur aus
  // den echten Tageseintraegen (DailyEntry.ferien) berechnet, nicht direkt eintragbar. Deckt aber
  // nicht den Fall ab, dass jemand Ferientage genommen, aber nie als Ferien-Tag erfasst hat (siehe
  // Andrit-Fall, 2026-09-16/21). Dieses Feld ist eine zusaetzliche Korrektur in TAGEN, die zur aus
  // den Tageseintraegen berechneten Anzahl addiert wird (siehe berechneFerienBezogenGesamt), statt
  // sie zu ersetzen, damit kuenftige echte Eintraege weiterhin korrekt mitgezaehlt werden.
  ferienBezogenKorrektur Float @default(0)

  // Nicht aus dem Original-Excel, App-eigenes Feature (CLAUDE.md §7): Tage VOR diesem Datum
  // zählen nicht (Soll=0, wie ein manueller Override) — löst die "leere Startphase" beim
  // Onboarding neuer Nutzer:innen, ohne hunderte DailyEntry-Zeilen anlegen zu müssen. NULL =
  // von Anfang Jahr an zählen (Standardverhalten, z.B. für Michael, der schon reale Daten hat).
  erfassungStartDatum DateTime?

  @@unique([userId, year])
}

// Entspricht einer Tageszeile in den Monatsblättern (CLAUDE.md §2/§3).
model DailyEntry {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id])
  userId String
  date   DateTime

  // Feste Kategorie-Stunden (Spalten L-Q)
  krank      Float @default(0)
  reisezeit  Float @default(0)
  cad        Float @default(0)
  ausbildung Float @default(0)
  buero      Float @default(0)
  ferien     Float @default(0)

  // Spesen (Spalten V, W)
  spesenFr Float @default(0)
  km       Float @default(0)

  // Manuelles Überschreiben von Soll (CLAUDE.md §3/§7 Punkt 2). Null = automatisch berechnet.
  sollOverride Float?

  // Stempelzeiten, bis zu 4 Start/Stop-Paare (Spalten Y-AF). Minuten seit Mitternacht, lokal.
  start1 Int?
  stop1  Int?
  start2 Int?
  stop2  Int?
  start3 Int?
  stop3  Int?
  start4 Int?
  stop4  Int?

  bookings Booking[]

  @@unique([userId, date])
}

// Projekt-/Kategorie-Buchung (Spalten C-K, CLAUDE.md §2). `label` ist historisch (freier Text,
// aus der Zeit vor der festen Projektliste) und wird beim Speichern weiterhin auf den Namen des
// gewählten Projekts gesetzt (Anzeige-Fallback für Altbuchungen ohne projectId). `projectId` ist
// die eigentliche Quelle der Wahrheit für neue Buchungen, siehe /admin/projekte und
// src/lib/projects.ts (Migration alter Buchungen anhand von `label`).
model Booking {
  id           String     @id @default(cuid())
  dailyEntry   DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  dailyEntryId String
  // onDelete: SetNull, damit das Loeschen eines deaktivierten Projekts (siehe /projekte) alte
  // Buchungen nicht mitreisst, sondern nur ihre Verknuepfung verliert. label bleibt als Text
  // erhalten, die Buchung ist danach wie eine noch nicht migrierte Altbuchung zu behandeln.
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId    String?
  label        String
  hours        Float
  kommentar    String     @default("")
}
